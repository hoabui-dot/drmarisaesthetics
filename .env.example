# ============================================
# Dental CMS - Environment Configuration
# ============================================
#
# Copy this file to .env and update values
# Generate secure keys: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# ============================================

# ============================================
# PostgreSQL Database
# ============================================
POSTGRES_DB=dental_cms_strapi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ============================================
# Strapi CMS
# ============================================

# Server
STRAPI_PORT=22345
STRAPI_PUBLIC_URL=http://localhost:22345

# Secrets (CHANGE THESE IN PRODUCTION!)
STRAPI_APP_KEYS=CHANGE_ME,CHANGE_ME,CHANGE_ME,CHANGE_ME
STRAPI_API_TOKEN_SALT=CHANGE_ME
STRAPI_ADMIN_JWT_SECRET=CHANGE_ME
STRAPI_TRANSFER_TOKEN_SALT=CHANGE_ME
STRAPI_JWT_SECRET=CHANGE_ME

# API Token (Generate in Strapi admin after setup)
STRAPI_API_TOKEN=your-api-token-here
STRAPI_URL=http://drmaris-strapi:22345
CLOUDFLARE_TUNNEL_HOST=localhost

# ============================================
# Next.js Frontend
# ============================================
FRONTEND_PORT=2234
NEXT_PUBLIC_SERVER_URL=http://localhost:2234
SITE_INDEXING_ENABLED=true
NEXT_PUBLIC_STRAPI_URL=http://localhost:22345
NEXT_PUBLIC_STRAPI_API_TOKEN=your-api-token-here
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=local-placeholder
NEXT_PUBLIC_RECAPTCHA_ENABLED=true
RECAPTCHA_ENABLED=true

# ============================================
# Development vs Production
# ============================================
NODE_ENV=development
