{
  "collectionName": "components_contact_map_sections",
  "info": {
    "displayName": "Clinic Location Section",
    "description": "Data-driven clinic map and location information section"
  },
  "options": {},
  "attributes": {
    "title": { "type": "string", "required": true, "default": "Vị trí phòng khám" },
    "address": { "type": "text", "required": true },
    "benefits": {
      "type": "component",
      "repeatable": true,
      "component": "contact.location-benefit"
    },
    "clinic_name": { "type": "string", "required": true, "default": "Smilux Dental Clinic" },
    "map_address": { "type": "text", "required": true },
    "map_latitude": { "type": "decimal", "required": true },
    "map_longitude": { "type": "decimal", "required": true },
    "map_zoom": { "type": "integer", "default": 16 },
    "directions_label": { "type": "string", "required": true, "default": "CHỈ ĐƯỜNG TRÊN GOOGLE MAPS" },
    "directions_url": { "type": "string" }
  }
}
