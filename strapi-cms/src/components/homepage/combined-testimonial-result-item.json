{
  "collectionName": "components_homepage_combined_testimonial_result_items",
  "info": {
    "displayName": "Combined Testimonial Result Item",
    "description": "A single item containing both a customer testimonial and their before/after images"
  },
  "options": {},
  "attributes": {
    "customerName": {
      "type": "string",
      "required": true
    },
    "content": {
      "type": "text",
      "required": true
    },
    "rating": {
      "type": "integer",
      "min": 1,
      "max": 5,
      "default": 5
    },
    "country": {
      "type": "string"
    },
    "beforeImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "afterImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "avatar": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    }
  }
}
