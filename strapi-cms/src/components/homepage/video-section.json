{
  "collectionName": "components_homepage_video_sections",
  "info": {
    "displayName": "Homepage video section",
    "description": "Customer video testimonial displayed directly below the homepage hero."
  },
  "options": {},
  "attributes": {
    "youtube_url": {
      "type": "string",
      "pluginOptions": { "content-manager": { "visible": false } }
    },
    "title": {
      "type": "string",
      "required": true,
      "default": "A patient's perspective",
      "maxLength": 255
    },
    "subtitle": {
      "type": "text"
    },
    "quote": {
      "type": "text",
      "pluginOptions": { "content-manager": { "visible": false } }
    },
    "customer_name": {
      "type": "string",
      "pluginOptions": { "content-manager": { "visible": false } }
    },
    "customer_description": {
      "type": "text",
      "pluginOptions": { "content-manager": { "visible": false } }
    },
    "thumbnail_url": {
      "type": "text",
      "pluginOptions": { "content-manager": { "visible": false } }
    },
    "stories": {
      "type": "component",
      "repeatable": true,
      "component": "homepage.video-story"
    }
  }
}
