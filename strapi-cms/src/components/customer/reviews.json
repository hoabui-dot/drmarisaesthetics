      "default": "5-Star Dental Clinic with Verified Patient Reviews"
    },
    "rating": {
      "type": "decimal",
      "default": 4.9
    },
    "total_reviews": {
      "type": "integer",
      "default": 400
    },
    "rating_subtitle": {
      "type": "string",
      "default": "rating from over 400 reviews on Google Maps"
    },
    "checklist": {
      "type": "component",
      "repeatable": true,
      "component": "customer.review-checklist-item"
    }
  }
}
