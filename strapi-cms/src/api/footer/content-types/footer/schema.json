      "repeatable": false
    },
    "footer_links": {
      "type": "component",
      "component": "footer.link",
      "repeatable": true
    },
    "link_groups": {
      "type": "component",
      "component": "footer.link-group",
      "repeatable": true
    },
    "social_links": {
      "type": "component",
      "component": "footer.social-link",
      "repeatable": true
    },
    "appointment_label": {
      "type": "string",
      "default": "BOOK APPOINTMENT"
    },
    "appointment_href": {
      "type": "string",
      "default": "/#home-booking"
    },
    "copyright_text": {
      "type": "string"
    },
    "tagline": {
      "type": "string",
      "default": "Designed with care for your smile."
    }
  }
}
