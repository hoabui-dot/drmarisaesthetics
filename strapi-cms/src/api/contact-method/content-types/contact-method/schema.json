{
  "kind": "collectionType",
  "collectionName": "contact_methods",
  "info": {
    "singularName": "contact-method",
    "pluralName": "contact-methods",
    "displayName": "Contact Method",
    "description": "Contact methods for floating contact widget and contact page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "type": {
      "type": "string",
      "required": true,
      "unique": false
    },
    "label": {
      "type": "string",
      "required": true
    },
    "href": {
      "type": "text",
      "required": true
    },
    "icon": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "color": {
      "type": "string",
      "required": false
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  }
}
