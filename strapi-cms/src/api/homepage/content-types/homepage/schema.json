{
  "kind": "singleType",
  "collectionName": "homepages",
  "info": {
    "singularName": "homepage",
    "pluralName": "homepages",
    "displayName": "Homepage",
    "description": "Dr. Maris Aesthetics editorial homepage"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "default": "Homepage"
    },
    "metadata_title": {
      "type": "string"
    },
    "metadata_description": {
      "type": "text"
    },
    "metadata_image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "visual_theme": {
      "type": "enumeration",
      "enum": ["clinical-blue"],
      "default": "clinical-blue"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "seo.page-seo"
    },
    "hero_content": { "type": "json" },
    "surgical_care_process": { "type": "json" },
    "revision_surgery": { "type": "json" },
    "doctor_assessment": { "type": "json" },
    "hospital_based_surgery": { "type": "json" },
    "international_patients": { "type": "json" },
    "international_journey": { "type": "json" },
    "consultation": { "type": "json" },
    "frequently_asked_questions": { "type": "json" }
  }
}
