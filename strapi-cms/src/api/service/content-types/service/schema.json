{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Service",
    "description": "Plastic surgery service guides"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "seo": { "type": "component", "repeatable": false, "component": "seo.page-seo" },
    "navigationLabel": { "type": "string", "required": false },
    "navigationOrder": {
      "type": "customField",
      "customField": "global::service-navigation-order",
      "required": false,
      "min": 1
    },
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "category": {
      "type": "enumeration",
      "enum": ["Plastic Surgery"],
      "required": false
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::service-category.service-category",
      "inversedBy": "services"
    },
    "coverImage": { "type": "media", "multiple": false, "required": false, "allowedTypes": ["images"] },
    "metaDescription": { "type": "text", "required": false },
    "contentBetterBlocks": {
      "type": "customField",
      "customField": "plugin::better-blocks.better-blocks",
      "required": false
    },
    "faq": {
      "type": "component",
      "repeatable": false,
      "component": "service.faq-section"
    }
  }
}
