{
  "kind": "singleType",
  "collectionName": "website_settings",
  "info": {
    "singularName": "website-setting",
    "pluralName": "website-settings",
    "displayName": "Website Settings",
    "description": "Reusable identity, contact and social settings for the website"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "site_name": { "type": "string", "required": true },
    "site_name_localized": { "type": "string" },
    "logo": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "favicon": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "default_open_graph_image": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "address": { "type": "text", "required": true },
    "phone_primary": { "type": "string", "required": true },
    "opening_hours": { "type": "string" },
    "website": { "type": "string" },
    "map_latitude": { "type": "decimal" },
    "map_longitude": { "type": "decimal" },
    "map_zoom": { "type": "integer", "default": 16 },
    "contact_methods": { "type": "component", "repeatable": true, "component": "website-setting.contact-method" },
    "social_links": { "type": "component", "repeatable": true, "component": "website-setting.social-link" },
    "global_cta": { "type": "component", "repeatable": false, "component": "website-setting.global-cta" },
    "booking_form": { "type": "component", "repeatable": false, "component": "website-setting.booking-form" }
  }
}
