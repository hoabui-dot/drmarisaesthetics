{
  "kind": "collectionType",
  "collectionName": "booking_submissions",
  "info": {
    "singularName": "booking-submission",
    "pluralName": "booking-submissions",
    "displayName": "Form Submissions",
    "description": "Booking, promotion and newsletter submissions from the website"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "full_name": {
      "type": "string",
      "maxLength": 100
    },
    "phone_number": {
      "type": "string",
      "maxLength": 20
    },
    "country": {
      "type": "string",
      "maxLength": 100
    },
    "service": {
      "type": "string"
    },
    "email": {
      "type": "email",
      "required": false
    },
    "other_service": {
      "type": "string",
      "required": false
    },
    "message": {
      "type": "text",
      "required": false,
      "maxLength": 1000
    },
    "ip_address": {
      "type": "string",
      "required": false
    },
    "user_agent": {
      "type": "text",
      "required": false
    },
    "booking_status": {
      "type": "enumeration",
      "enum": ["new", "contacted", "scheduled", "completed", "cancelled"],
      "default": "new",
      "required": false
    },
    "submission_type": {
      "type": "enumeration",
      "enum": ["booking", "promotion", "newsletter"],
      "default": "booking",
      "required": true
    },
    "submission_source": {
      "type": "enumeration",
      "enum": [
        "homepage",
        "about_us",
        "contact",
        "booking_modal",
        "service_detail",
        "promotion_popup",
        "blog_newsletter"
      ],
      "default": "booking_modal",
      "required": true
    }
  }
}
