{
  "kind": "collectionType",
  "collectionName": "booking_submissions",
  "info": {
    "singularName": "booking-submission",
    "pluralName": "booking-submissions",
    "displayName": "Booking Submission",
    "description": "Contact and booking form submissions from website"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "full_name": {
      "type": "string",
      "required": true,
      "minLength": 2,
      "maxLength": 100
    },
    "phone_number": {
      "type": "string",
      "required": true,
      "minLength": 8,
      "maxLength": 20
    },
    "service": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": false
    },
    "other_service": {
      "type": "string",
      "required": false
    },
    "message": {
      "type": "text",
      "required": false,
      "maxLength": 1000
    },
    "ip_address": {
      "type": "string",
      "required": false
    },
    "user_agent": {
      "type": "text",
      "required": false
    },
    "booking_status": {
      "type": "enumeration",
      "enum": ["new", "contacted", "scheduled", "completed", "cancelled"],
      "default": "new"
    }
  }
}
