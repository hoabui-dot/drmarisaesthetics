    "next": "15.4.11",
    "nodemailer": "^8.0.5",
    "postcss": "^8.5.8",
    "qs": "^6.15.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-google-recaptcha-v3": "^1.11.0",
    "react-hook-form": "^7.71.2",
    "react-markdown": "^10.1.0",
