# ============================================
# Next.js Frontend - Environment Configuration
# ============================================
#
# Copy this file to .env and update values
# ALL VARIABLES ARE REQUIRED - NO DEFAULTS PROVIDED
# ============================================

# Frontend Server (Required)
NEXT_PUBLIC_SERVER_URL=https://your-site-domain
SITE_INDEXING_ENABLED=true

# Strapi API Configuration (Required)
STRAPI_URL=
STRAPI_API_TOKEN=

# Public Strapi Configuration (Required)
NEXT_PUBLIC_STRAPI_URL=
NEXT_PUBLIC_STRAPI_API_TOKEN=

# Preview Mode Secret (Required)
NEXT_PREVIEW_SECRET=

# Webhook Secret (Optional)
STRAPI_WEBHOOK_SECRET=

# ============================================
# Google reCAPTCHA v3 Configuration (Required)
# ============================================
# Get your keys from: https://www.google.com/recaptcha/admin
# Use reCAPTCHA v3 (invisible, score-based)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_ENABLED=true
RECAPTCHA_ENABLED=true

# ============================================
# Email Configuration (Required)
# ============================================
# SMTP Server Configuration
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=

# Email Addresses
EMAIL_FROM=
EMAIL_FROM_NAME=
EMAIL_TO_ADMIN=
EMAIL_TO_STAFF=

# Email Settings
EMAIL_ENABLED=
EMAIL_RETRY_ATTEMPTS=
EMAIL_RETRY_DELAY=

# ============================================
# Example Values (DO NOT USE IN PRODUCTION)
# ============================================
# NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# STRAPI_URL=https://guild-biblical-expectations-easily.trycloudflare.com
# STRAPI_API_TOKEN=your-strapi-api-token-here
# NEXT_PUBLIC_STRAPI_URL=https://guild-biblical-expectations-easily.trycloudflare.com
# NEXT_PUBLIC_STRAPI_API_TOKEN=your-strapi-api-token-here
# NEXT_PREVIEW_SECRET=your-secure-preview-secret-change-in-production
# STRAPI_WEBHOOK_SECRET=your-secure-webhook-secret-change-in-production
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key-here
# RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key-here
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-gmail-app-password
